generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AttachmentCategory {
  PHOTO
  RADIOGRAPH
  CLINICAL_HISTORY
  PAYMENT_RECEIPT
  PAYMENT_HISTORY
  OTHER
}

enum ImportBatchStatus {
  PREVIEW
  COMMITTED
  FAILED
}

enum ImportItemStatus {
  READY
  IMPORTED
  DUPLICATE
  FAILED
}

enum ChargeStatus {
  OPEN
  PAID
  VOID
}

enum PaymentStatus {
  CONFIRMED
  PENDING
  VOID
}

enum PaymentHistoryUploadStatus {
  LOCAL_ONLY
  UPLOADED
  FAILED
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Patient {
  id                   String                @id @default(cuid())
  fullName             String
  email                String?
  phone                String?
  birthDate            DateTime?
  notes                String?
  folderAliases        String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  attachments          Attachment[]
  clinicalEntries      ClinicalEntry[]
  charges              TreatmentCharge[]
  payments             Payment[]
  paymentHistorySheets PaymentHistorySheet[]

  @@index([fullName])
}

model Attachment {
  id                  String               @id @default(cuid())
  patientId           String
  category            AttachmentCategory
  originalName        String
  vaultPath           String
  mimeType            String?
  sizeBytes           Int
  sha256              String               @unique
  sourceRelativePath  String
  importedAt          DateTime             @default(now())
  serviceDate         DateTime?
  capturedAt          DateTime?
  importBatchId       String?
  clinicalEntryId     String?
  chargeId            String?
  paymentId           String?
  patient             Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  importBatch         ImportBatch?         @relation(fields: [importBatchId], references: [id])
  clinicalEntry       ClinicalEntry?       @relation(fields: [clinicalEntryId], references: [id])
  charge              TreatmentCharge?     @relation(fields: [chargeId], references: [id])
  payment             Payment?             @relation(fields: [paymentId], references: [id])
  importItems         ImportItem[]
  paymentHistorySheet PaymentHistorySheet?

  @@index([patientId, category])
  @@index([importBatchId])
}

model ClinicalEntry {
  id          String       @id @default(cuid())
  patientId   String
  entryDate   DateTime
  tooth       String?
  diagnosis   String?
  treatment   String?
  notes       String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([patientId, entryDate])
}

model TreatmentCharge {
  id          String       @id @default(cuid())
  patientId   String
  description String
  amountCents Int
  currency    String
  serviceDate DateTime
  status      ChargeStatus @default(OPEN)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([patientId, serviceDate])
}

model Payment {
  id          String        @id @default(cuid())
  patientId   String
  amountCents Int
  currency    String
  paidAt      DateTime
  method      String
  status      PaymentStatus @default(CONFIRMED)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([patientId, paidAt])
}

model PaymentHistorySheet {
  id             String                     @id @default(cuid())
  patientId      String
  attachmentId   String                     @unique
  googleFileId   String?
  googleUrl      String?
  googleFolderId String?
  uploadStatus   PaymentHistoryUploadStatus @default(LOCAL_ONLY)
  uploadedAt     DateTime?
  errorMessage   String?
  isActive       Boolean                    @default(false)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  patient        Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  attachment     Attachment                 @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@index([patientId, isActive])
  @@index([patientId, createdAt])
}

model ImportBatch {
  id             String            @id @default(cuid())
  sourceRootName String
  status         ImportBatchStatus @default(PREVIEW)
  fileCount      Int               @default(0)
  importedCount  Int               @default(0)
  duplicateCount Int               @default(0)
  errorCount     Int               @default(0)
  createdAt      DateTime          @default(now())
  committedAt    DateTime?
  items          ImportItem[]
  attachments    Attachment[]
}

model ImportItem {
  id                 String             @id @default(cuid())
  batchId            String
  candidateId        String
  patientName        String
  category           AttachmentCategory
  originalName       String
  sourceRelativePath String
  sha256             String
  sizeBytes          Int
  status             ImportItemStatus   @default(READY)
  message            String?
  attachmentId       String?
  createdAt          DateTime           @default(now())
  batch              ImportBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  attachment         Attachment?        @relation(fields: [attachmentId], references: [id])

  @@unique([batchId, candidateId])
  @@index([batchId, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  event     String
  entity    String
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())
}
